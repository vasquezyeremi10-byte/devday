{
  "name": "mina-cero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "art:miner": "node scripts/art/build-miner.mjs && node scripts/art/build-interactions.mjs",
    "art:interactions": "node scripts/art/build-interactions.mjs",
    "art:hero": "node scripts/art/build-hero.mjs",
    "art:gnome": "node scripts/art/build-gnome.mjs && prettier --write src/game/config/gnomeFrames.ts",
    "art:import": "node scripts/art/import-assets.mjs",
    "art:menu-bg": "node scripts/art/build-menu-bg.mjs",
    "art:studio-logo": "node scripts/art/build-studio-logo.mjs",
    "audio:intro": "node scripts/audio/build-intro-sfx.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
